{
  "about": "Golden cases for the sitemap crawl, shared by TryGeoSuite/sitemap-builder (test/fixtures/golden-sitemap.json, run by test/golden.test.js) and the GeoSuite platform (geo: backend/tests/fixtures/golden-sitemap.json, run by backend/tests/tools/test_sitemap_builder_golden.py). The two files must stay identical. crawl cases run with concurrency 1 against the `site` map: a URL not in it answers 404, `location` redirects, everything else is served with its status, content_type (default text/html), last_modified and body. After an intended change: node scripts/update-golden.mjs in the package, review the diff, copy the file to geo, make the Python side pass.",
  "start_url": [
    {
      "name": "bare domain gets https",
      "input": "example.com",
      "expected": "https://example.com/"
    },
    {
      "name": "spaces trimmed, host lowercased, default port and fragment dropped",
      "input": " https://Example.COM:443/Path?q=1#top ",
      "expected": "https://example.com/Path?q=1"
    },
    {
      "name": "other port kept",
      "input": "http://example.com:8080/x",
      "expected": "http://example.com:8080/x"
    },
    {
      "name": "localhost with a port",
      "input": "localhost:3000",
      "expected": "https://localhost:3000/"
    },
    {
      "name": "host without a dot",
      "input": "intranet",
      "expected": null
    },
    {
      "name": "not http",
      "input": "ftp://example.com/",
      "expected": null
    },
    {
      "name": "spaces inside",
      "input": "not a url",
      "expected": null
    },
    {
      "name": "empty",
      "input": "",
      "expected": null
    }
  ],
  "links": [
    {
      "name": "same origin only, normalized and sorted",
      "current_url": "https://example.com/blog/post",
      "origin": "https://example.com",
      "html": "<a href=\"/zeta\">x</a><a href=\"../sibling\">x</a><a href=\"?q=1\">x</a><a href=\"//example.com/proto-relative\">x</a><a href=\"  /spaced  \">x</a><a href=\"/a b\">x</a><a href=\"/x#frag\">x</a><a href=\"#only\">x</a><a href=\"javascript:void(0)\">x</a><a href=\"/style.CSS\">x</a><a href=\"/path-with.dot/in-segment\">x</a><a href=\"http://example.com/other-scheme\">x</a><a href=\"/p?q=a b&amp;c=d\">x</a><a href=\"/über\">x</a><a href=\"https://example.com:443/port\">x</a><a href=\"/%7Euser\">x</a><a href=\"/a|b\">x</a><a href=\"./\">x</a><a href=\"https://other.com/\">x</a><a href=\"tel:+390000\">x</a><a href=\"/About\">x</a><link href=\"/not-an-anchor\"><A HREF='/upper-tag'>u</A>",
      "expected": [
        "https://example.com/%7Euser",
        "https://example.com/%C3%BCber",
        "https://example.com/About",
        "https://example.com/a%20b",
        "https://example.com/a|b",
        "https://example.com/blog/",
        "https://example.com/blog/post?q=1",
        "https://example.com/p?q=a%20b&c=d",
        "https://example.com/path-with.dot/in-segment",
        "https://example.com/port",
        "https://example.com/proto-relative",
        "https://example.com/sibling",
        "https://example.com/spaced",
        "https://example.com/upper-tag",
        "https://example.com/x",
        "https://example.com/zeta"
      ]
    },
    {
      "name": "nothing to follow",
      "current_url": "https://example.com/",
      "origin": "https://example.com",
      "html": "<p>no links</p>",
      "expected": []
    }
  ],
  "last_modified": [
    {
      "name": "RFC 1123",
      "header": "Wed, 21 Oct 2026 07:28:00 GMT",
      "expected": "2026-10-21"
    },
    {
      "name": "offset converted to UTC",
      "header": "Thu, 22 Oct 2026 01:30:00 +0200",
      "expected": "2026-10-21"
    },
    {
      "name": "ISO date is not an HTTP date",
      "header": "2026-10-21",
      "expected": null
    },
    {
      "name": "garbage",
      "header": "garbage",
      "expected": null
    },
    {
      "name": "missing",
      "header": null,
      "expected": null
    }
  ],
  "render": [
    {
      "name": "loc escaped, lastmod only when present",
      "pages": [
        {
          "url": "https://example.com/"
        },
        {
          "url": "https://example.com/p?a=1&b=<2>",
          "lastmod": "2026-10-21"
        },
        {
          "url": ""
        }
      ],
      "expected": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url>\n    <loc>https://example.com/</loc>\n  </url>\n  <url>\n    <loc>https://example.com/p?a=1&amp;b=&lt;2&gt;</loc>\n    <lastmod>2026-10-21</lastmod>\n  </url>\n</urlset>\n"
    },
    {
      "name": "no pages",
      "pages": [],
      "expected": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n</urlset>\n"
    }
  ],
  "robots": [
    {
      "name": "consecutive user-agent lines share a group",
      "agent": "*",
      "robots_txt": "User-agent: *\nUser-agent: Googlebot\nDisallow: /private\n",
      "paths": [
        "/private/x",
        "/public"
      ],
      "expected": {
        "/private/x": false,
        "/public": true
      }
    },
    {
      "name": "longest match wins, Allow on a tie",
      "agent": "*",
      "robots_txt": "User-agent: *\nDisallow: /shop\nAllow: /shop/public\nDisallow: /page\nAllow: /page\n",
      "paths": [
        "/shop/x",
        "/shop/public/a",
        "/page",
        "/pages"
      ],
      "expected": {
        "/shop/x": false,
        "/shop/public/a": true,
        "/page": true,
        "/pages": true
      }
    },
    {
      "name": "wildcards and end anchor",
      "agent": "*",
      "robots_txt": "User-agent: *\nDisallow: /*.pdf$\nDisallow: /*?\nDisallow: /tmp*/cache\n",
      "paths": [
        "/a/b.pdf",
        "/a/b.pdfx",
        "/tmp1/cache/x",
        "/tmp/x"
      ],
      "expected": {
        "/a/b.pdf": false,
        "/a/b.pdfx": true,
        "/tmp1/cache/x": false,
        "/tmp/x": true
      }
    },
    {
      "name": "empty Disallow allows everything",
      "agent": "*",
      "robots_txt": "User-agent: *\nDisallow:\n",
      "paths": [
        "/",
        "/anything"
      ],
      "expected": {
        "/": true,
        "/anything": true
      }
    },
    {
      "name": "a group for another bot does not apply to *",
      "agent": "*",
      "robots_txt": "User-agent: GPTBot\nDisallow: /\n",
      "paths": [
        "/",
        "/x"
      ],
      "expected": {
        "/": true,
        "/x": true
      }
    },
    {
      "name": "named agent group wins over *",
      "agent": "GPTBot",
      "robots_txt": "User-agent: *\nDisallow: /\n\nUser-agent: gptbot\nAllow: /\nDisallow: /secret\n",
      "paths": [
        "/",
        "/secret/a"
      ],
      "expected": {
        "/": true,
        "/secret/a": false
      }
    },
    {
      "name": "percent-encoding is decoded on both sides",
      "agent": "*",
      "robots_txt": "User-agent: *\nDisallow: /caf%C3%A9\n",
      "paths": [
        "/café/menu",
        "/caf%C3%A9/menu",
        "/cafe"
      ],
      "expected": {
        "/café/menu": false,
        "/caf%C3%A9/menu": false,
        "/cafe": true
      }
    },
    {
      "name": "rules before any user-agent are ignored, comments stripped",
      "agent": "*",
      "robots_txt": "Disallow: /early\n# comment\nUser-agent: * # everyone\nDisallow: /late # trailing\n",
      "paths": [
        "/early",
        "/late"
      ],
      "expected": {
        "/early": true,
        "/late": false
      }
    },
    {
      "name": "the first * group with a matching rule decides",
      "agent": "*",
      "robots_txt": "User-agent: *\nDisallow: /a\n\nUser-agent: *\nAllow: /a/b\n",
      "paths": [
        "/a/b",
        "/a/c"
      ],
      "expected": {
        "/a/b": false,
        "/a/c": false
      }
    },
    {
      "name": "non-rule lines do not split a group",
      "agent": "*",
      "robots_txt": "User-agent: bingbot\nCrawl-delay: 5\nUser-agent: *\nDisallow: /x\nSitemap: https://example.com/sitemap.xml\n",
      "paths": [
        "/x",
        "/y"
      ],
      "expected": {
        "/x": false,
        "/y": true
      }
    }
  ],
